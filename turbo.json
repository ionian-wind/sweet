{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "NODE_ENV", "BABEL_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "lib/**", "*.js", "*.flow"]
    },
    "@ionian-wind/sweet-core#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@ionian-wind/sweet-spec#build": {
      "dependsOn": ["@ionian-wind/sweet-core#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build", "@ionian-wind/sweet-spec#build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "@ionian-wind/sweet-spec#build"],
      "outputs": []
    },
    "coverage": {
      "dependsOn": ["^build", "@ionian-wind/sweet-spec#build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
