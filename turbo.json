{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "NODE_ENV", "BABEL_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "lib/**", "*.js", "*.flow"]
    },
    "@sweet-js/core#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "sweet-spec#build": {
      "dependsOn": ["@sweet-js/core#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build", "sweet-spec#build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "sweet-spec#build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
