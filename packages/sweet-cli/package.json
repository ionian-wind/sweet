{
  "name": "@ionian-wind/sweet",
  "description": "Hygienic Macros for JavaScript",
  "bin": {
    "sjs": "bin/sjs.js"
  },
  "version": "3.0.13",
  "engines": {
    "node": "^22.20.0 || >=24.12.0"
  },
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet-cli/master/LICENSE.BSD"
    }
  ],
  "dependencies": {
    "@ionian-wind/sweet-core": "3.0.13",
    "semver": "7.8.6",
    "yargs": "18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionian-wind/sweet.git",
    "directory": "packages/sweet-cli"
  },
  "keywords": [
    "macros",
    "javascript",
    "parser"
  ],
  "license": "BSD-2-Clause",
  "type": "module",
  "scripts": {
    "test": "ava",
    "coverage": "c8 ava"
  },
  "devDependencies": {
    "ava": "8.4.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  },
  "contributors": [
    "Tim Disney"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin"
  ],
  "homepage": "https://www.sweetjs.org",
  "bugs": {
    "url": "https://github.com/ionian-wind/sweet/issues"
  }
}
