{
  "name": "@ionian-wind/sweet-core",
  "description": "Hygienic Macros for JavaScript",
  "main": "dist/sweet.js",
  "version": "3.0.13",
  "engines": {
    "node": "^22.20.0 || >=24.12.0"
  },
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet.js/master/LICENSE.BSD"
    }
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint src test && flow",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "prebuild": "mkdir -p dist/",
    "build:src": "babel --out-dir dist/ src",
    "build": "npm run build:src",
    "preprofile": "npm run build",
    "profile": "node --prof profile.js && node --prof-process *v8.log > v8-processed.log && rm *v8.log",
    "pretest": "npm run lint",
    "test:262": "ava test/parser/test-run-test262.js",
    "test:ci": "npm run pretest && ava && ava test/parser/test-*.js",
    "test": "ava",
    "coverage": "c8 ava",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "helpers.js"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@babel/core": "8.1.0",
    "immutable": "5.1.10",
    "ramda": "0.32.0",
    "ramda-fantasy": "0.8.0",
    "readtable": "0.0.1",
    "resolve": "1.22.14",
    "shift-codegen": "8.1.0",
    "transit-js": "0.8.874",
    "utils-dirname": "1.0.0",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-flow": "8.0.1",
    "@ionian-wind/sweet-spec": "4.1.0"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@sweet-js/eslint-config": "0.0.0",
    "angular": "1.8.3",
    "ava": "8.4.0",
    "eslint": "10.14.0",
    "expect.js": "0.3.1",
    "flow-bin": "0.339.0",
    "jquery": "4.0.0",
    "rimraf": "6.1.4",
    "@sweet-js/test-loader": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionian-wind/sweet.git",
    "directory": "packages/sweet-core"
  },
  "keywords": [
    "macros",
    "javascript"
  ],
  "license": "BSD-2-Clause",
  "ava": {
    "failWithoutAssertions": false,
    "files": [
      "test/unit/*.js",
      "test/parser/test-ast.js",
      "test/parser/test-compile-external-libs.js"
    ],
    "nodeArguments": [
      "--import",
      "./ava.setup.mjs"
    ],
    "timeout": "2m"
  },
  "type": "module",
  "exports": {
    ".": "./dist/sweet.js",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./helpers.js": "./helpers.js",
    "./package.json": "./package.json"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "ava.setup.mjs",
      "test/**",
      "dist/**",
      "build/**"
    ],
    "check-coverage": true,
    "statements": 90,
    "branches": 87,
    "lines": 90,
    "functions": 90
  },
  "contributors": [
    "Tim Disney"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.sweetjs.org",
  "bugs": {
    "url": "https://github.com/ionian-wind/sweet/issues"
  }
}
