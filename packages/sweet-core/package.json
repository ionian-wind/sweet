{
  "name": "@sweet-js/core",
  "description": "Hygienic Macros for JavaScript",
  "main": "dist/sweet.js",
  "version": "3.0.13",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Tim Disney",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet.js/master/LICENSE.BSD"
    }
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint src test && flow",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "prebuild": "mkdir -p dist/",
    "build:src": "babel --out-dir dist/ src",
    "build": "npm run build:src",
    "preprofile": "npm run build",
    "profile": "node --prof profile.js && node --prof-process *v8.log > v8-processed.log && rm *v8.log",
    "pretest": "npm run lint",
    "test:262": "ava test/parser/test-run-test262.js",
    "test:ci": "npm run pretest && ava && ava test/parser/test-*.js",
    "test": "ava",
    "prepublish": "npm run build"
  },
  "files": [
    "dist",
    "helpers.js"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@babel/core": "7.29.13",
    "@sweet-js/babel-preset": "0.0.0",
    "immutable": "5.1.10",
    "ramda": "0.32.0",
    "ramda-fantasy": "0.8.0",
    "readtable": "0.0.1",
    "resolve": "1.22.14",
    "shift-codegen": "8.1.0",
    "sweet-spec": "4.1.0",
    "transit-js": "0.8.874",
    "utils-dirname": "1.0.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/register": "7.29.13",
    "@sweet-js/eslint-config": "0.0.0",
    "angular": "1.6.0",
    "ava": "5.3.1",
    "eslint": "9.39.5",
    "expect.js": "0.3.1",
    "flow-bin": "0.339.0",
    "jquery": "3.1.1",
    "rimraf": "6.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/sweet-js/sweet.js.git"
  },
  "keywords": [
    "macros",
    "javascript"
  ],
  "license": "BSD-2-Clause",
  "ava": {
    "failWithoutAssertions": false,
    "files": [
      "test/unit/*.js",
      "test/parser/test-ast.js"
    ],
    "require": [
      "@babel/register"
    ]
  }
}
