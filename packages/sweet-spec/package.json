{
  "name": "@ionian-wind/sweet-spec",
  "version": "4.1.0",
  "description": "The Sweet.js Term specification",
  "main": "dist/term-spec.js",
  "scripts": {
    "prebuild": "mkdir -p dist && mkdir -p build",
    "build:sweet": "sjs --out-dir build src/term-spec.js",
    "build:babel:esm": "babel --out-dir dist build",
    "build:flow": "sh gen-flow.sh",
    "build": "npm run build:sweet && npm run build:babel:esm && npm run build:flow",
    "test": "ava",
    "coverage": "c8 ava",
    "prepublishOnly": "npm run build"
  },
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@sweet-js/babel-preset": "0.0.0",
    "@ionian-wind/sweet": "3.0.13",
    "@ionian-wind/sweet-core": "3.0.13",
    "ava": "8.4.0",
    "@ionian-wind/sweet-spec-macro": "3.0.0"
  },
  "exports": {
    ".": "./dist/term-spec.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**",
      "build/**",
      "dist/term-spec.js"
    ]
  },
  "contributors": [
    "Tim Disney"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://www.sweetjs.org",
  "bugs": {
    "url": "https://github.com/ionian-wind/sweet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionian-wind/sweet.git",
    "directory": "packages/sweet-spec"
  }
}
