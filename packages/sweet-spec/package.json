{
  "name": "sweet-spec",
  "version": "4.1.0",
  "description": "The Sweet.js Term specification",
  "main": "dist/term-spec.js",
  "scripts": {
    "prebuild": "mkdir -p dist && mkdir -p build",
    "build:sweet": "sjs --out-dir build src/term-spec.js",
    "build:babel:esm": "babel --out-dir dist build",
    "build:flow": "sh gen-flow.sh",
    "build": "npm run build:sweet && npm run build:babel:esm && npm run build:flow",
    "publish": "npm run build",
    "test": "echo \"No tests in sweet-spec\""
  },
  "author": "Tim Disney",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@sweet-js/babel-preset": "0.0.0",
    "sweet-spec-macro": "3.0.0",
    "@sweet-js/cli": "3.0.13",
    "@sweet-js/core": "3.0.13"
  },
  "exports": {
    ".": "./dist/term-spec.js",
    "./package.json": "./package.json"
  },
  "type": "module"
}
