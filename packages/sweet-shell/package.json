{
  "name": "sweet.js",
  "version": "3.0.15",
  "description": "Deprecated workspace wrapper, use @ionian-wind/sweet or @ionian-wind/sweet-core instead",
  "main": "index.js",
  "bin": {
    "sjs": "sjs.js"
  },
  "scripts": {
    "test": "ava",
    "coverage": "c8 ava"
  },
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet-shell/master/LICENSE.BSD"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionian-wind/sweet.git",
    "directory": "packages/sweet-shell"
  },
  "keywords": [
    "macros",
    "javascript"
  ],
  "license": "BSD-2-Clause",
  "dependencies": {
    "@ionian-wind/sweet": "3.0.13",
    "@ionian-wind/sweet-core": "3.0.13"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./node-loader.js": "./node-loader.js",
    "./helpers.js": "./helpers.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "ava": "8.4.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  },
  "contributors": [
    "Tim Disney"
  ],
  "files": [
    "index.js",
    "node-loader.js",
    "helpers.js",
    "sjs.js"
  ],
  "homepage": "https://www.sweetjs.org",
  "bugs": {
    "url": "https://github.com/ionian-wind/sweet/issues"
  },
  "private": true
}
