{
  "name": "sweet.js",
  "version": "3.0.15",
  "description": "Deprecated package, use sweet-cli or sweet-core instead",
  "main": "index.js",
  "bin": {
    "sjs": "sjs.js"
  },
  "scripts": {
    "test": "ava",
    "coverage": "c8 ava"
  },
  "author": "Tim Disney",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet-shell/master/LICENSE.BSD"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/sweet-js/sweet-shell.git"
  },
  "keywords": [
    "macros",
    "javascript"
  ],
  "license": "BSD-2-Clause",
  "dependencies": {
    "@sweet-js/cli": "3.0.13",
    "@sweet-js/core": "3.0.13"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./node-loader.js": "./node-loader.js",
    "./helpers.js": "./helpers.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "ava": "8.4.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  }
}
