{
  "name": "sweet-spec-macro",
  "version": "3.0.0",
  "description": "A Sweet.js macro for defining specs",
  "main": "src/spec.js",
  "scripts": {
    "test": "ava"
  },
  "author": "Tim Disney",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@sweet-js/babel-preset": "0.0.0",
    "ava": "8.4.0",
    "@sweet-js/core": "3.0.13",
    "@sweet-js/test-loader": "0.0.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "nodeArguments": [
      "--import",
      "./ava.setup.mjs"
    ]
  }
}
