{
  "name": "@sweet-js/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat config for the sweet-monorepo packages",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "dependencies": {
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-flow": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0"
  },
  "peerDependencies": {
    "@babel/core": "8.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  },
  "scripts": {
    "test": "ava",
    "coverage": "c8 ava"
  },
  "devDependencies": {
    "ava": "8.4.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  },
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>"
}
