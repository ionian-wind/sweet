{
  "name": "@sweet-js/helpers",
  "version": "4.0.1",
  "description": "A helper library for writing Sweet macros",
  "main": "helpers.js",
  "scripts": {
    "pretest": "npm run build",
    "test": "ava",
    "build": "babel --no-babelrc --config-file ./babel.build.json --out-dir . src",
    "prepack": "npm run build && for i in src/*.js; do cp \"$i\" \"./$(basename $i).flow\"; done;",
    "lint": "eslint src test && flow",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\""
  },
  "files": [
    "*.js",
    "*.flow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet-js/sweet-helpers.git"
  },
  "keywords": [
    "macros"
  ],
  "author": "Tim Disney",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet-helpers/master/LICENSE.BSD"
    }
  ],
  "bugs": {
    "url": "https://github.com/sweet-js/sweet-helpers/issues"
  },
  "homepage": "https://github.com/sweet-js/sweet-helpers#readme",
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/register": "7.29.13",
    "@sweet-js/babel-preset": "0.0.0",
    "@sweet-js/core": "3.0.13",
    "@sweet-js/eslint-config": "0.0.0",
    "ava": "5.3.1",
    "eslint": "9.39.5",
    "flow-bin": "0.339.0"
  },
  "ava": {
    "files": [
      "test/**/*.js"
    ],
    "require": [
      "@babel/register"
    ]
  }
}
