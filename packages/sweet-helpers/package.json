{
  "name": "@ionian-wind/sweet-helpers",
  "version": "4.0.1",
  "description": "A helper library for writing Sweet macros",
  "main": "helpers.js",
  "scripts": {
    "pretest": "npm run build",
    "test": "ava",
    "build": "babel --no-babelrc --config-file ./babel.build.json --out-dir . src",
    "prepack": "npm run build && for i in src/*.js; do cp \"$i\" \"./$(basename $i).flow\"; done;",
    "lint": "eslint src test && flow",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "coverage": "c8 ava"
  },
  "files": [
    "*.js",
    "*.flow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionian-wind/sweet.git",
    "directory": "packages/sweet-helpers"
  },
  "keywords": [
    "macros"
  ],
  "author": "Dmitry Shadrunov <ionian.wind@gmail.com>",
  "licenses": [
    {
      "type": "BSD",
      "url": "http://github.com/sweet-js/sweet-helpers/master/LICENSE.BSD"
    }
  ],
  "bugs": {
    "url": "https://github.com/ionian-wind/sweet/issues"
  },
  "homepage": "https://www.sweetjs.org",
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@sweet-js/babel-preset": "0.0.0",
    "@ionian-wind/sweet-core": "3.0.13",
    "@sweet-js/eslint-config": "0.0.0",
    "ava": "8.4.0",
    "eslint": "10.14.0",
    "flow-bin": "0.339.0",
    "@sweet-js/test-loader": "0.0.0"
  },
  "ava": {
    "files": [
      "test/**/*.js"
    ],
    "nodeArguments": [
      "--import",
      "./ava.setup.mjs"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "ava.setup.mjs",
      "test/**",
      "dist/**",
      "build/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  },
  "contributors": [
    "Tim Disney"
  ],
  "publishConfig": {
    "access": "public"
  }
}
