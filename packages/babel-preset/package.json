{
  "name": "@sweet-js/babel-preset",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Babel preset for the sweet-monorepo packages",
  "main": "index.js",
  "dependencies": {
    "@babel/preset-env": "8.0.7",
    "@babel/preset-flow": "8.0.1"
  },
  "peerDependencies": {
    "@babel/core": "8.1.0"
  },
  "type": "module",
  "scripts": {
    "test": "ava",
    "coverage": "c8 ava"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "ava": "8.4.0"
  },
  "ava": {
    "files": [
      "test/*.js"
    ],
    "timeout": "2m"
  },
  "c8": {
    "reporter": [
      "text-summary"
    ],
    "exclude": [
      "test/**"
    ],
    "check-coverage": true,
    "statements": 87,
    "branches": 87,
    "functions": 87,
    "lines": 87
  }
}
